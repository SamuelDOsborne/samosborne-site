<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Composure Through Conflict | Sam Osborne & David Graf | Keynote Duo</title>
    <meta name="description" content="Composure Through Conflict: Stop Taking Things So Personally. A keynote duo with Sam Osborne & David Graf. Rated 4.7/5 at CAI Law Seminar 2026. Book for your next event.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --charcoal: #1A1A1A;
            --white: #FFFFFF;
            --gold: #D4A574;
            --gold-light: rgba(212, 165, 116, 0.15);
            --slate: #4A5E7F;
            --warmGrey: #F5F3F0;
            --textDark: #1d1d1f;
            --textMuted: #6e6e73;
            --textLight: #f5f5f7;
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Work Sans', sans-serif;
            background: var(--charcoal);
            color: var(--textLight);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* ===== NAV ===== */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(26, 26, 26, 0.75);
            backdrop-filter: blur(20px);
            z-index: 1000;
            padding: 18px 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            transition: all 0.3s ease;
        }
        nav.scrolled {
            background: rgba(26, 26, 26, 0.95);
            padding: 13px 0;
            border-bottom: 1px solid rgba(255,255,255,0.10);
        }
        .nav-content {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .nav-logo {
            display: flex;
            flex-direction: column;
            text-decoration: none;
        }
        .nav-logo .brand { font-size: 17px; font-weight: 600; color: var(--white); letter-spacing: -0.01em; }
        .nav-logo .sub { font-size: 11px; color: var(--gold); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 500; }
        .nav-links { display: flex; gap: 32px; list-style: none; }
        .nav-links a { color: rgba(245,245,247,0.82); text-decoration: none; font-size: 14px; font-weight: 500; transition: color 0.25s; }
        .nav-links a:hover { color: var(--gold); }
        .nav-cta {
            background: var(--slate);
            color: var(--white) !important;
            padding: 9px 22px;
            border-radius: 999px;
            font-weight: 600 !important;
            transition: background 0.25s ease !important;
        }
        .nav-cta:hover { background: var(--gold) !important; color: var(--white) !important; }

        /* ===== HERO ===== */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 120px 40px 80px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 50% 0%, rgba(74, 94, 127, 0.18) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 80% 80%, rgba(212, 165, 116, 0.08) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(212, 165, 116, 0.12);
            border: 1px solid rgba(212, 165, 116, 0.35);
            border-radius: 999px;
            padding: 8px 20px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 36px;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.1s forwards;
        }
        .hero-tag::before {
            content: '★';
            font-size: 11px;
        }

        .hero-eyebrow {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(18px, 2vw, 22px);
            font-style: italic;
            color: rgba(245,245,247,0.60);
            margin-bottom: 16px;
            letter-spacing: 0.04em;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.2s forwards;
        }

        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(52px, 8vw, 110px);
            font-weight: 700;
            line-height: 0.95;
            letter-spacing: -0.02em;
            color: var(--white);
            margin-bottom: 12px;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.3s forwards;
        }
        .hero-title em {
            font-style: italic;
            color: var(--gold);
        }

        .hero-subtitle {
            font-size: clamp(18px, 2.2vw, 24px);
            color: rgba(245,245,247,0.68);
            max-width: 680px;
            margin: 24px auto 0;
            font-weight: 300;
            line-height: 1.5;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.4s forwards;
        }

        .hero-speakers {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 28px;
            margin-top: 52px;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.5s forwards;
        }
        .speaker-chip {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .speaker-chip .name {
            font-size: 17px;
            font-weight: 600;
            color: var(--white);
        }
        .speaker-chip .role {
            font-size: 12px;
            color: rgba(245,245,247,0.55);
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .speaker-divider {
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            color: var(--gold);
            opacity: 0.7;
            font-style: italic;
        }

        .hero-cta-group {
            display: flex;
            gap: 16px;
            justify-content: center;
            margin-top: 48px;
            flex-wrap: wrap;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.6s forwards;
        }
        .btn-primary {
            background: var(--slate);
            color: var(--white);
            padding: 15px 38px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            border: 2px solid transparent;
            transition: all 0.25s ease;
            display: inline-block;
        }
        .btn-primary:hover { background: var(--gold); transform: translateY(-1px); }
        .btn-secondary {
            background: transparent;
            color: var(--white);
            padding: 15px 38px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            border: 2px solid rgba(255,255,255,0.35);
            transition: all 0.25s ease;
            display: inline-block;
        }
        .btn-secondary:hover { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.07); }

        .hero-score {
            margin-top: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            opacity: 0;
            animation: fadeUp 0.7s ease 0.7s forwards;
        }
        .score-item {
            text-align: center;
            padding: 20px 28px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
        }
        .score-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 42px;
            font-weight: 700;
            color: var(--gold);
            line-height: 1;
        }
        .score-label {
            font-size: 12px;
            color: rgba(245,245,247,0.55);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 6px;
        }
        .score-stars {
            color: var(--gold);
            font-size: 14px;
            margin-top: 4px;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ===== SECTION HELPERS ===== */
        .section { padding: 100px 40px; }
        .section-content { max-width: 1200px; margin: 0 auto; }
        .section-dark { background: var(--charcoal); }
        .section-light { background: var(--warmGrey); color: var(--textDark); }
        .section-mid {
            background: #141414;
        }

        .section-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 16px;
        }
        .section-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(38px, 5vw, 64px);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.01em;
        }
        .section-dark .section-title, .section-mid .section-title { color: var(--white); }
        .section-light .section-title { color: var(--textDark); }

        .section-desc {
            font-size: clamp(17px, 1.8vw, 20px);
            line-height: 1.65;
            max-width: 720px;
        }
        .section-dark .section-desc, .section-mid .section-desc { color: rgba(245,245,247,0.72); }
        .section-light .section-desc { color: var(--textMuted); }

        hr.divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,0.08);
            margin: 60px 0;
        }
        .section-light hr.divider { border-top-color: rgba(0,0,0,0.08); }

        /* ===== TESTIMONIALS ===== */
        .testimonials-band {
            background: #0e0e0e;
            padding: 80px 40px;
            overflow: hidden;
        }
        .testimonials-band .section-label { text-align: center; }
        .testimonials-band .section-title { text-align: center; color: var(--white); margin-bottom: 16px; }
        .testimonials-band .section-desc { text-align: center; margin: 0 auto 50px; }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .t-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 32px;
            transition: all 0.35s ease;
            position: relative;
        }
        .t-card:hover {
            background: rgba(255,255,255,0.055);
            border-color: rgba(212,165,116,0.3);
            transform: translateY(-4px);
        }
        .t-card.featured {
            border-color: rgba(212,165,116,0.4);
            background: rgba(212,165,116,0.05);
        }
        .t-stars { color: var(--gold); font-size: 14px; margin-bottom: 16px; }
        .t-quote {
            font-family: 'Cormorant Garamond', serif;
            font-size: 18px;
            font-style: italic;
            line-height: 1.6;
            color: rgba(245,245,247,0.88);
            margin-bottom: 20px;
        }
        .t-author {
            font-size: 13px;
            font-weight: 600;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .t-title {
            font-size: 12px;
            color: rgba(245,245,247,0.45);
            margin-top: 3px;
        }

        /* ===== SPEAKERS SECTION ===== */
        .speakers-section { padding: 100px 40px; background: var(--charcoal); }
        .speakers-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            max-width: 1100px;
            margin: 60px auto 0;
        }
        .speaker-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 24px;
            padding: 50px 44px;
            transition: all 0.4s ease;
        }
        .speaker-card:hover {
            background: rgba(255,255,255,0.055);
            border-color: rgba(212,165,116,0.3);
            transform: translateY(-6px);
        }
        .speaker-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 36px;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 4px;
            line-height: 1.1;
        }
        .speaker-cred {
            font-size: 13px;
            color: var(--gold);
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 24px;
        }
        .speaker-bio {
            font-size: 16px;
            line-height: 1.7;
            color: rgba(245,245,247,0.72);
        }
        .speaker-stats {
            display: flex;
            gap: 24px;
            margin-top: 28px;
            padding-top: 28px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }
        .stat-block { text-align: center; }
        .stat-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 32px;
            font-weight: 700;
            color: var(--gold);
            line-height: 1;
        }
        .stat-lbl {
            font-size: 11px;
            color: rgba(245,245,247,0.45);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-top: 4px;
        }

        /* ===== EVALUATION SECTION ===== */
        .eval-section { padding: 100px 40px; background: var(--warmGrey); }
        .eval-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 24px;
            margin: 50px 0;
        }
        .eval-card {
            background: white;
            border: 1px solid rgba(0,0,0,0.07);
            border-radius: 18px;
            padding: 34px 28px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
            transition: all 0.3s ease;
        }
        .eval-card:hover { transform: translateY(-5px); box-shadow: 0 16px 44px rgba(0,0,0,0.1); }
        .eval-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 52px;
            font-weight: 700;
            color: var(--slate);
            line-height: 1;
        }
        .eval-out-of { font-size: 16px; color: var(--textMuted); }
        .eval-label {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--textDark);
            margin-top: 10px;
        }
        .eval-sub {
            font-size: 12px;
            color: var(--textMuted);
            margin-top: 4px;
        }

        .excellence-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-top: 40px;
        }
        .excellence-card {
            background: white;
            border: 1px solid rgba(0,0,0,0.07);
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.05);
        }
        .excellence-card h4 {
            font-size: 16px;
            font-weight: 700;
            color: var(--textDark);
            margin-bottom: 16px;
        }
        .bar-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }
        .bar-label { font-size: 13px; color: var(--textMuted); width: 70px; flex-shrink: 0; }
        .bar-track {
            flex: 1;
            height: 8px;
            background: rgba(0,0,0,0.07);
            border-radius: 99px;
            overflow: hidden;
        }
        .bar-fill {
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, var(--slate), var(--gold));
        }
        .bar-pct { font-size: 13px; font-weight: 700; color: var(--textDark); width: 38px; text-align: right; }

        /* ===== WHAT YOU GET ===== */
        .outcomes-section { padding: 100px 40px; background: #0e0e0e; }
        .outcomes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 28px;
            margin-top: 50px;
        }
        .outcome-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 40px;
            transition: all 0.35s ease;
        }
        .outcome-card:hover {
            background: rgba(255,255,255,0.055);
            border-color: rgba(212,165,116,0.3);
            transform: translateY(-4px);
        }
        .outcome-icon { font-size: 28px; margin-bottom: 20px; }
        .outcome-title {
            font-size: 19px;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 12px;
        }
        .outcome-desc {
            font-size: 15px;
            line-height: 1.65;
            color: rgba(245,245,247,0.65);
        }

        /* ===== WHO SECTION ===== */
        .who-section { padding: 100px 40px; background: var(--charcoal); }
        .who-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
            margin-top: 50px;
        }
        .who-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 36px;
            transition: all 0.35s ease;
        }
        .who-card:hover {
            background: rgba(255,255,255,0.055);
            border-color: rgba(74,94,127,0.5);
            transform: translateY(-4px);
        }
        .who-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 12px;
        }
        .who-desc {
            font-size: 15px;
            line-height: 1.65;
            color: rgba(245,245,247,0.62);
        }

        /* ===== CONTACT FORM ===== */
        .contact-section { padding: 100px 40px; background: var(--charcoal); }
        .form-container {
            max-width: 720px;
            margin: 50px auto 0;
        }
        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group { margin-bottom: 20px; }
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: rgba(245,245,247,0.85);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }
        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid rgba(255,255,255,0.11);
            border-radius: 8px;
            background: rgba(255,255,255,0.05);
            color: white;
            font-size: 15px;
            font-family: inherit;
            box-sizing: border-box;
            transition: border-color 0.25s ease;
            outline: none;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--gold);
        }
        .form-select option { background: #1A1A1A; }
        .form-textarea { resize: vertical; }
        .form-submit {
            width: 100%;
            padding: 16px 32px;
            background: var(--slate);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.25s ease;
        }
        .form-submit:hover { background: var(--gold); }
        .form-note {
            text-align: center;
            color: rgba(245,245,247,0.45);
            font-size: 13px;
            margin-top: 14px;
        }

        /* Budget radios */
        .budget-options { display: flex; gap: 14px; flex-wrap: wrap; }
        .budget-option {
            display: flex;
            align-items: center;
            gap: 7px;
            color: rgba(245,245,247,0.65);
            font-size: 14px;
            cursor: pointer;
        }

        /* ===== FOOTER ===== */
        footer {
            background: #0d0d0d;
            padding: 50px 40px 36px;
            border-top: 1px solid rgba(255,255,255,0.07);
        }
        .footer-inner {
            max-width: 1000px;
            margin: 0 auto;
            text-align: center;
        }
        .footer-names {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            color: var(--white);
            margin-bottom: 6px;
        }
        .footer-tagline { font-size: 14px; color: rgba(245,245,247,0.45); margin-bottom: 28px; }
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 24px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .footer-links a { color: rgba(245,245,247,0.45); text-decoration: none; font-size: 13px; transition: color 0.25s; }
        .footer-links a:hover { color: var(--gold); }
        .footer-copy { font-size: 13px; color: rgba(245,245,247,0.3); }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 900px) {
            .speakers-grid, .excellence-grid { grid-template-columns: 1fr; }
            .form-grid-2 { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            .nav-links { display: none; }
            .section, .testimonials-band, .eval-section, .outcomes-section, .who-section, .contact-section { padding: 70px 20px; }
            .hero { padding: 100px 20px 60px; }
            .hero-title { font-size: clamp(46px, 10vw, 80px); }
            .hero-speakers { flex-direction: column; gap: 16px; }
            .speaker-divider { transform: rotate(90deg); }
        }

        /* Accordion details */
        details { margin-top: 20px; }
        details summary {
            list-style: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            color: var(--gold);
            display: flex;
            align-items: center;
            gap: 8px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        details summary::-webkit-details-marker { display: none; }
        details summary .chev { transition: transform 0.25s; font-size: 12px; }
        details[open] summary .chev { transform: rotate(180deg); }
        details .details-body {
            padding-top: 16px;
            font-size: 15px;
            line-height: 1.7;
            color: rgba(245,245,247,0.65);
        }
    </style>
</head>

<body>
    <!-- NAV -->
    <nav id="nav">
        <div class="nav-content">
            <a href="#top" class="nav-logo">
                <span class="brand">Osborne × Graf</span>
                <span class="sub">Composure Through Conflict</span>
            </a>
            <ul class="nav-links">
                <li><a href="#session">The Session</a></li>
